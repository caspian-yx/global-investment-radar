<!doctype html>
<html lang="{% if web_primary_zh %}zh-CN{% else %}en{% endif %}">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{% if web_primary_zh %}全球投资雷达{% else %}Global Investment Radar{% endif %} · {{ briefing.report_date }}</title>
<style>
:root{--bg:#f5f5f7;--ink:#111113;--muted:#6e6e73;--line:#e4e4e8;--up:#16845b;--down:#c53d45;--accent:#2b6cff;--glass:rgba(255,255,255,.68);--shadow:0 18px 48px rgba(35,35,42,.08);--r:20px}*{box-sizing:border-box}html{background:var(--bg);color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display","PingFang SC","Microsoft YaHei",sans-serif;line-height:1.5}body{margin:0;background:radial-gradient(circle at 8% -10%,#fff 0,#f5f5f7 42%,#eef0f5 100%);font-variant-numeric:tabular-nums}.wrap{max-width:1160px;margin:auto;padding:0 24px 72px}.sticky{position:sticky;top:0;z-index:4;margin:0 -24px 34px;padding:14px 24px;background:rgba(245,245,247,.76);border-bottom:1px solid rgba(255,255,255,.7);backdrop-filter:blur(18px) saturate(130%);-webkit-backdrop-filter:blur(18px) saturate(130%)}.nav,.nav-right{display:flex;align-items:center;gap:16px}.nav{justify-content:space-between}.brand{font-size:14px;font-weight:700;letter-spacing:.02em}.nav-right{font-size:12px;color:var(--muted)}.pill,.segmented button{border:1px solid rgba(0,0,0,.07);border-radius:999px;padding:6px 11px;background:rgba(255,255,255,.6);color:var(--muted)}.hero{padding:28px 0 30px}.eyebrow{text-transform:uppercase;letter-spacing:.11em;font-size:11px;color:var(--muted);font-weight:700}.hero h1{font-size:clamp(34px,6vw,68px);letter-spacing:-.055em;line-height:.98;margin:11px 0}.hero p{color:var(--muted);margin:0;max-width:700px}.glass,.card,.panel{background:var(--glass);border:1px solid rgba(255,255,255,.84);box-shadow:var(--shadow);border-radius:var(--r);position:relative;overflow:hidden}.glass:before,.card:before,.panel:before{content:"";position:absolute;inset:0;border-radius:inherit;box-shadow:inset 0 1px 0 rgba(255,255,255,.9),inset 0 0 24px rgba(255,255,255,.18);pointer-events:none}.overview{padding:22px}.section{margin-top:52px}.section-head{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:17px}.section-head h2{font-size:28px;letter-spacing:-.035em;margin:3px 0 0}.tape{display:flex;gap:11px;overflow:auto;scroll-snap-type:x mandatory;padding:2px 2px 8px}.market-card{flex:0 0 194px;scroll-snap-align:start;padding:17px;background:rgba(255,255,255,.78);border:1px solid var(--line);border-radius:14px;text-align:left;cursor:pointer;transition:transform .18s ease,box-shadow .18s ease,border-color .18s ease}.market-card:hover,.market-card:focus-visible{transform:translateY(-2px);box-shadow:0 10px 24px rgba(35,35,42,.11);border-color:#bfc8e2;outline:none}.market-card.selected{border-color:var(--accent);box-shadow:0 0 0 3px rgba(43,108,255,.12)}.asset-name{font-size:13px;font-weight:700}.asset-en{color:var(--muted);font-size:11px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.level{font-size:28px;letter-spacing:-.04em;margin:11px 0 4px}.move{font-size:13px;font-weight:700}.up{color:var(--up)}.down{color:var(--down)}.flat,.muted,.detail{color:var(--muted)}.detail{font-size:11px;margin-top:7px}.focus-grid{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(260px,.65fr);gap:14px}.focus-card{padding:25px;min-height:220px}.focus-card h3{font-size:29px;line-height:1.08;letter-spacing:-.035em;margin:13px 0}.focus-card p{color:var(--muted);max-width:610px}.focus-side{display:grid;gap:14px}.focus-mini{padding:19px}.focus-mini h3{font-size:17px;margin:7px 0}.rank{display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:50%;background:#111;color:white;font-size:12px}.chart-card{padding:23px}.chart-controls{display:flex;flex-wrap:wrap;align-items:center;gap:10px;margin:14px 0}.asset-tabs{display:flex;gap:7px;overflow:auto}.asset-tab,.segmented button{cursor:pointer;font:inherit}.asset-tab.active,.segmented button.active{background:#111;color:#fff;border-color:#111}.segmented{display:flex;gap:5px;margin-left:auto}.trend-shell{position:relative;min-height:295px;border-radius:16px;background:linear-gradient(180deg,rgba(255,255,255,.72),rgba(244,246,252,.58));overflow:hidden}.trend-shell svg{display:block;width:100%;height:295px}.grid-line{stroke:#dfe2ea;stroke-width:1}.trend-path{fill:none;stroke:#111;stroke-width:3;stroke-linecap:round;stroke-linejoin:round}.trend-area{fill:url(#trendGradient);opacity:.22}.trend-meta{display:flex;justify-content:space-between;color:var(--muted);font-size:12px;padding-top:9px}.tooltip{position:absolute;display:none;pointer-events:none;background:#111;color:#fff;padding:7px 9px;border-radius:9px;font-size:11px;z-index:2}.two-col{display:grid;grid-template-columns:1fr 1fr;gap:14px}.panel{padding:22px}.panel h3{margin:0 0 12px;font-size:20px;letter-spacing:-.025em}.story,.note,.next-item{display:grid;grid-template-columns:auto 1fr;gap:13px;padding:15px 0;border-top:1px solid var(--line)}.story:first-child,.note:first-child,.next-item:first-child{border-top:0}.story h3,.note h3,.next-item h3{margin:0 0 5px;font-size:16px}.story p,.note p,.next-item p{margin:0;color:var(--muted);font-size:14px}.story-side{font-size:10px;color:var(--muted);text-align:right;white-space:nowrap}.tag{display:inline-block;font-size:10px;padding:4px 7px;border-radius:999px;background:#eef1f7;color:#4b5563}.signal{padding:13px 0;border-top:1px solid var(--line)}.signal:first-child{border-top:0}.signal strong{display:block}.signal small{color:var(--muted)}.bars{display:grid;gap:10px}.bar-row{display:grid;grid-template-columns:92px 1fr 58px;gap:9px;align-items:center;font-size:12px}.bar-track{height:7px;background:#e6e8ed;border-radius:99px;overflow:hidden}.bar-fill{height:100%;border-radius:99px;background:#111}.bar-fill.negative{background:#a3a7af}.china-indices{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:18px}.china-index{padding:11px;border-radius:12px;background:rgba(255,255,255,.72);border:1px solid var(--line)}.china-index b{display:block;font-size:13px}.china-index span{font-size:12px}.details{border-top:1px solid var(--line);padding-top:12px;margin-top:12px}.details summary{cursor:pointer;font-weight:700}.brief{padding:25px;background:linear-gradient(135deg,rgba(255,255,255,.78),rgba(228,235,255,.72));}.brief p{margin:9px 0;color:#4d5260}.footer{margin-top:55px;color:#92949b;font-size:11px;letter-spacing:.08em}@media(max-width:760px){.wrap{padding:0 15px 50px}.sticky{margin-left:-15px;margin-right:-15px;padding-left:15px;padding-right:15px}.nav-right .pill{display:none}.hero h1{font-size:42px}.focus-grid,.two-col{grid-template-columns:1fr}.section-head h2{font-size:24px}.market-card{flex-basis:170px}.china-indices{grid-template-columns:repeat(2,1fr)}.segmented{margin-left:0}.chart-controls{align-items:flex-start;flex-direction:column}.trend-shell,.trend-shell svg{min-height:240px;height:240px}}@media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;animation-duration:.001ms!important;animation-iteration-count:1!important;transition-duration:.001ms!important}.market-card:hover{transform:none}}
</style><style>.compatibility{display:none}.microtrend{display:block;margin-top:7px;color:var(--muted);font-size:10px;letter-spacing:.04em}.microtrend[data-sparkline=""]{opacity:.65}.focus-mini p{min-height:2.8em}.story .tag{line-height:1.5}</style>
</head>
<body><div class="wrap">
<header class="sticky"><div class="nav"><div class="brand">GLOBAL INVESTMENT RADAR</div><div class="nav-right"><span>{{ briefing.report_date }}</span><span class="pill">{% if web_primary_zh %}中文优先{% else %}English{% endif %}</span></div></div></header>
<main>
<section class="hero"><div class="eyebrow">Daily market intelligence · {{ data_mode|upper }}</div><h1>{% if web_primary_zh %}全球投资雷达{% else %}Global Investment Radar{% endif %}</h1><p>{% if web_primary_zh %}先看市场怎样移动，再看哪些信息真正改变了定价。{% else %}A structured view of what moved, what mattered, and what remains unresolved.{% endif %}</p></section>
<section class="glass overview" id="market-regime"><div class="section-head"><div><div class="eyebrow">Market Regime</div><h2>{% if web_primary_zh %}市场状态（内部确定性标签）{% else %}Market regime (internal deterministic label){% endif %}</h2></div><span class="tag">{{ web_report.regime.state.value }}</span></div><p><strong>{{ web_report.regime.label }}</strong></p><p class="muted">{% if web_primary_zh %}当前定价线索由已验证的市场观察与跨资产信号构成；它不是未经证实的因果结论。{% else %}This label summarizes validated observations and deterministic cross-asset signals; it is not an unverified causal claim.{% endif %}</p><p class="detail">{% if web_primary_zh %}支持资产{% else %}Supporting assets{% endif %} · {{ web_report.regime.supporting_symbols|join(' / ') or 'Unavailable' }}</p></section>
<section class="glass overview" id="market-overview"><div class="section-head"><div><div class="eyebrow">{% if web_primary_zh %}市场总览{% else %}Market overview{% endif %}</div><h2>{% if web_primary_zh %}全球市场{% else %}Global markets{% endif %}</h2></div><span class="tag">{{ web_report.market_cards|length }} {% if web_primary_zh %}个已验证观察{% else %}validated observations{% endif %}</span></div><div class="tape" aria-label="Market overview">{% for item in web_report.market_cards[:8] %}<button class="market-card {% if loop.first %}selected{% endif %}" type="button" data-market-key="{{ item.canonical_key }}" aria-pressed="{% if loop.first %}true{% else %}false{% endif %}"><span class="asset-name">{{ item.label_zh if web_primary_zh else item.label_en }}</span><span class="asset-en">{{ item.label_en }} · {{ item.provider_symbol }}</span><div class="level">{{ '%.2f'|format(item.level) }}</div><div class="move {{ item.direction }}">{{ '%+.2f'|format(item.absolute_change) }}{% if item.absolute_unit %} {{ item.absolute_unit }}{% endif %} · {{ '%+.2f'|format(item.change_pct) }}%</div><div class="detail">{{ item.session }}</div></button>{% else %}<p class="muted">No validated market observations.</p>{% endfor %}</div>{% if web_report.market_cards|length > 8 %}<details class="details"><summary>{% if web_primary_zh %}展开区域与次级资产{% else %}Expand regional and secondary assets{% endif %}</summary><div class="tape">{% for item in web_report.market_cards[8:] %}<div class="market-card"><span class="asset-name">{{ item.label_zh if web_primary_zh else item.label_en }}</span><span class="asset-en">{{ item.provider_symbol }}</span><div class="level">{{ '%.2f'|format(item.level) }}</div><div class="move {{ item.direction }}">{{ '%+.2f'|format(item.change_pct) }}%</div></div>{% endfor %}</div></details>{% endif %}</section>
<section class="section" id="focus"><div class="section-head"><div><div class="eyebrow">{% if web_primary_zh %}今日焦点{% else %}Today’s focus{% endif %}</div><h2>{% if web_primary_zh %}最值得先读的 3–5 件事{% else %}What deserves attention first{% endif %}</h2></div><span class="tag">{% if web_report.localization_unavailable %}Localization unavailable{% else %}Evidence-linked{% endif %}</span></div><div class="focus-grid"><article class="card focus-card">{% set focus = web_report.primary_stories[0] if web_report.primary_stories else none %}{% if focus %}<span class="rank">01</span><h3>{{ localized_primary_stories[focus.event_id].headline if localized_primary and localized_primary_stories.get(focus.event_id) else focus.headline }}</h3><p>{{ localized_primary_stories[focus.event_id].why_it_matters if localized_primary and localized_primary_stories.get(focus.event_id) else web_report.story_explanations.get(focus.event_id, focus.why_it_matters) }}</p>{% else %}<h3>{% if web_primary_zh %}今天没有达到主标题阈值的故事{% else %}No primary story cleared today’s threshold{% endif %}</h3>{% endif %}</article><div class="focus-side">{% for item in web_report.priority_highlights[:2] %}<article class="card focus-mini"><span class="tag">{{ item.kind|replace('_',' ') }}</span><h3>{{ item.title_zh if web_primary_zh else item.title_en }}</h3><p>{{ item.detail_zh if web_primary_zh else item.detail_en }}</p></article>{% endfor %}{% for story in web_report.primary_stories[1:4] %}<article class="card focus-mini"><span class="tag">{{ '%02d'|format(loop.index + 1) }}</span><h3>{{ localized_primary_stories[story.event_id].headline if localized_primary and localized_primary_stories.get(story.event_id) else story.headline }}</h3><p>{{ localized_primary_stories[story.event_id].why_it_matters if localized_primary and localized_primary_stories.get(story.event_id) else story.why_it_matters }}</p></article>{% endfor %}</div></div></section>
<section class="section" id="trend"><div class="section-head"><div><div class="eyebrow">{% if web_primary_zh %}市场趋势{% else %}Market trend{% endif %}</div><h2>{% if web_primary_zh %}真实历史，不为凑图{% else %}Real history, no decorative charts{% endif %}</h2></div><span class="tag">Visual budget {{ web_report.major_visuals|length }} / 2</span></div><div class="card chart-card"><div class="chart-controls"><div class="asset-tabs" role="tablist" aria-label="Trend assets">{% set tab_ns = namespace(first=true) %}{% for series in web_report.trend_series if series.range_key == '1W' %}<button class="asset-tab {% if tab_ns.first %}active{% set tab_ns.first=false %}{% endif %}" type="button" role="tab" aria-selected="{% if loop.first %}true{% else %}false{% endif %}" data-trend-key="{{ series.canonical_key }}">{{ series.label_zh if web_primary_zh else series.label_en }}</button>{% endfor %}</div><div class="segmented" role="group" aria-label="Trend range"><button class="active" type="button" data-range="1D">1D</button><button type="button" data-range="1W">1W</button><button type="button" data-range="1M">1M</button></div></div><div class="trend-shell" data-trend-shell><div class="tooltip" data-tooltip></div><svg viewBox="0 0 720 280" role="img" aria-label="Market trend"><defs><linearGradient id="trendGradient" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#2b6cff"/><stop offset="1" stop-color="#2b6cff" stop-opacity="0"/></linearGradient></defs><line class="grid-line" x1="0" y1="72" x2="720" y2="72"/><line class="grid-line" x1="0" y1="140" x2="720" y2="140"/><line class="grid-line" x1="0" y1="208" x2="720" y2="208"/>{% for series in web_report.trend_series %}<path class="trend-area" data-trend-path data-key="{{ series.canonical_key }}" data-range="{{ series.range_key }}" data-points='{{ series.points|tojson }}' d="{{ series.area_path }}" {% if not (loop.first) %}hidden{% endif %}></path><path class="trend-path" data-trend-path data-key="{{ series.canonical_key }}" data-range="{{ series.range_key }}" data-points='{{ series.points|tojson }}' d="{{ series.path }}" {% if not (loop.first) %}hidden{% endif %}></path>{% endfor %}</svg>{% if not web_report.trend_series %}<div class="unavailable">{% if web_primary_zh %}没有足够真实历史生成可用趋势图。{% else %}Insufficient real history for an eligible trend visual.{% endif %}</div>{% endif %}</div><div class="trend-meta"><span>{% if web_primary_zh %}悬停或触摸图线查看时间与数值{% else %}Hover or touch the line for time and value{% endif %}</span><span>{% if web_report.trend_series %}{{ web_report.trend_series[0].label_en }}{% else %}No eligible series{% endif %}</span></div></div></section>
<section class="section" id="china-a-shares"><div class="section-head"><div><div class="eyebrow">{% if web_primary_zh %}中国 / A股{% else %}China / A-Shares{% endif %}</div><h2>{% if web_primary_zh %}本地市场观察{% else %}Local market context{% endif %}</h2></div></div><div class="panel">{% if web_report.china.indices %}<div class="china-indices">{% for item in web_report.china.indices[:8] %}<div class="china-index"><b>{{ item.name }}</b><span>{{ '%.2f'|format(item.close) }} <em class="{{ 'up' if item.change_pct > 0 else 'down' if item.change_pct < 0 else 'flat' }}">{{ '%+.2f'|format(item.change_pct) }}%</em></span></div>{% endfor %}</div>{% else %}<div class="unavailable">{% if web_primary_zh %}核心指数数据暂不可用；没有使用 Demo 数据填充。{% else %}Core index data unavailable; no demo values were inserted.{% endif %}</div>{% endif %}{% if web_report.china.sectors %}<h3>{% if web_primary_zh %}行业排名{% else %}Sector ranking{% endif %}</h3><div class="bars">{% for sector in web_report.china.sectors[:8] %}{% set width = [sector.change_1d|abs * 14, 100]|min %}<div class="bar-row"><span>{{ sector.sector }}</span><span class="bar-track"><span class="bar-fill {% if sector.change_1d < 0 %}negative{% endif %}" style="width:{{ width }}%"></span></span><b class="{{ 'up' if sector.change_1d > 0 else 'down' if sector.change_1d < 0 else 'flat' }}">{{ '%+.2f'|format(sector.change_1d) }}%</b></div>{% endfor %}</div><p class="detail">Top / Bottom · {{ web_report.china.sectors[0].sector }} / {{ web_report.china.sectors[-1].sector }} · Sector advance/decline {{ web_report.china.breadth[0] }}/{{ web_report.china.breadth[1] }} · Leadership {{ web_report.china.leadership or 'Unavailable' }}</p>{% else %}<p class="muted">Sector ranking appears only when structured sector observations are available.</p>{% endif %}<details class="details"><summary>{% if web_primary_zh %}数据能力与缺口{% else %}Capabilities and gaps{% endif %}</summary><p class="detail">Source: {{ web_report.china_capabilities.source or 'Unavailable' }} · {% for item in web_report.china_capabilities.unavailable %}{{ item }}{% if not loop.last %}, {% endif %}{% else %}No declared capability gaps{% endfor %}</p></details></div></section>
<section class="section" id="risk"><div class="section-head"><div><div class="eyebrow">Volatility &amp; Rates</div><h2>{% if web_primary_zh %}波动率与利率{% else %}Risk and rates{% endif %}</h2></div></div><div class="two-col"><div class="panel"><h3>VIX / VXN</h3>{% for key in ('VIX','VXN','US_2Y','US_10Y','WTI') %}{% set card = (web_report.market_cards|selectattr('canonical_key','equalto',key)|list|first) %}{% if card %}{% set context = (web_report.multi_day|selectattr('symbol','equalto',card.provider_symbol)|list|first) %}<div class="signal"><strong>{{ card.label_zh if web_primary_zh else card.label_en }} · {{ '%.2f'|format(card.level) }} <span class="{{ card.direction }}">{{ '%+.2f'|format(card.change_pct) }}%</span></strong><small>{{ card.provider_symbol }} · {{ card.absolute_change }} {{ card.absolute_unit }} · 5D {% if context and context.change_5d is not none %}{{ '%+.2f'|format(context.change_5d) }}%{% else %}unavailable{% endif %} · 7D {% if context and context.change_7d is not none %}{{ '%+.2f'|format(context.change_7d) }}%{% else %}unavailable{% endif %}</small><span class="microtrend" role="img" aria-label="7-day sparkline context" data-sparkline="{{ web_report.sparkline_points.get(card.provider_symbol, '') }}">7D context · {% if context and context.regime %}{{ context.regime }}{% else %}history unavailable{% endif %}</span></div>{% endif %}{% endfor %}</div><div class="panel"><h3>{% if web_primary_zh %}传导背景{% else %}Transmission context{% endif %}</h3><p class="muted">{% if web_primary_zh %}Fed → rates → equities 的链路只引用已验证的市场观察与证据；regime 保留为内部确定性标签。{% else %}Fed → rates → equities uses validated observations and evidence; regime remains an internal deterministic label.{% endif %}</p>{% for gap in web_report.coverage_gaps %}{% if gap.code in ('MISSING_VIX','MISSING_VXN','MISSING_US2Y','MISSING_US10Y','MISSING_WTI') %}<div class="unavailable">{{ gap.reason }}</div>{% endif %}{% endfor %}</div></div></section>
<section class="section" id="cross-asset"><div class="section-head"><div><div class="eyebrow">{% if web_primary_zh %}跨资产情报{% else %}Cross-asset intelligence{% endif %}</div><h2>{% if web_primary_zh %}数字先于结论{% else %}Numbers before conclusions{% endif %}</h2></div></div><div class="panel">{% for item in web_report.cross_asset_signals %}<div class="signal"><strong>{{ item.label_zh if web_primary_zh else item.label }}</strong><small>{{ item.detail_zh if web_primary_zh else item.label }} · {{ item.state.value }} · {{ item.symbols|join(' / ') }}</small></div>{% else %}<p class="muted">{% if web_primary_zh %}没有达到确定性阈值的跨资产信号。{% else %}No deterministic cross-asset signal cleared the current threshold.{% endif %}</p>{% endfor %}{% for move in web_report.abnormal_moves %}<div class="signal"><strong>{{ move.name }} · {{ '%+.2f'|format(move.change_pct) }}%</strong><small>{% if move.state.value == 'DRIVER_UNRESOLVED' %}{% if web_primary_zh %}主要驱动暂未确认。{% else %}Driver unresolved.{% endif %}{% else %}{{ move.reason }}{% endif %}</small></div>{% endfor %}</div></section>
<section class="section" id="overnight"><div class="section-head"><div><div class="eyebrow">{% if web_primary_zh %}隔夜情报{% else %}Overnight intelligence{% endif %}</div><h2>{% if web_primary_zh %}更新鲜的信息在前{% else %}Fresh information first{% endif %}</h2></div></div><div class="panel">{% for story in web_report.primary_stories %}{% set freshness = web_report.freshness.get(story.event_id) %}<article class="story"><span class="rank">{{ '%02d'|format(freshness.new_rank if freshness and freshness.new_rank else loop.index) }}</span><div><h3>{{ localized_primary_stories[story.event_id].headline if localized_primary and localized_primary_stories.get(story.event_id) else story.headline }}</h3><p>{{ localized_primary_stories[story.event_id].why_it_matters if localized_primary and localized_primary_stories.get(story.event_id) else web_report.story_explanations.get(story.event_id, story.why_it_matters) }}</p><span class="tag">{{ freshness.band.value if freshness else 'UNKNOWN' }} · {% if freshness and freshness.information_gain %}Information gain{% else %}Decay{% endif %} · previous #{{ freshness.previous_rank if freshness else '?' }}{% if freshness and freshness.new_rank %} → new #{{ freshness.new_rank }}{% endif %}</span></div><span class="story-side">{{ story.priority_band.value|replace('_',' ') }}</span></article>{% else %}<p class="muted">No current story cleared the headline threshold.</p>{% endfor %}</div></section>
<section class="section" id="watch-next"><div class="two-col"><div class="panel"><div class="eyebrow">{% if web_primary_zh %}今日关注{% else %}Watch today{% endif %}</div>{% for item in web_report.watch_today[:5] %}<article class="next-item"><span class="rank">{{ loop.index }}</span><div><h3>{{ localized_watch_items[item.event_id].headline if localized_primary and localized_watch_items.get(item.event_id) else item.headline }}</h3><p>{{ localized_watch_items[item.event_id].text if localized_primary and localized_watch_items.get(item.event_id) else item.text }}</p></div></article>{% else %}<p class="muted">No watch item was inferred.</p>{% endfor %}</div><div class="panel"><div class="eyebrow">{% if web_primary_zh %}接下来关注{% else %}What matters next{% endif %}</div>{% for item in web_report.next_horizons.next_24_hours %}<article class="next-item"><span class="rank">{{ loop.index }}</span><div><h3>{{ item.title }}</h3><p>{{ item.text }}</p><small class="muted">Confirm · {{ item.confirmation }}<br>Invalidate · {{ item.invalidation }}</small></div></article>{% else %}<p class="muted">No validated future catalyst is available.</p>{% endfor %}</div></div></section>
<section class="section" id="secondary"><div class="section-head"><div><div class="eyebrow">{% if web_primary_zh %}次要进展{% else %}Secondary developments{% endif %}</div><h2>{% if web_primary_zh %}保留，但不抢主线{% else %}Retained without stealing focus{% endif %}</h2></div></div><div class="panel">{% for item in briefing.under_radar %}<article class="note"><span class="tag">Secondary</span><div><h3>{{ item.headline }}</h3><p>{{ item.note }}</p></div></article>{% endfor %}{% for item in web_report.decayed_stories %}{% set freshness = web_report.freshness.get(item.event_id) %}<article class="note"><span class="tag">Stale · {{ freshness.decision if freshness else 'DEMOTE_SECONDARY' }}</span><div><h3>{{ item.headline }}</h3><p>{{ freshness.decay_reason if freshness else 'Headline decay: no new information gain.' }} · previous #{{ freshness.previous_rank if freshness else '?' }} → Secondary / Decayed.</p></div></article>{% endfor %}{% if not briefing.under_radar and not web_report.decayed_stories %}<p class="muted">No additional item cleared the conservative secondary threshold.</p>{% endif %}</div></section>
<section class="section" id="brief"><div class="brief"><div class="eyebrow">{% if web_primary_zh %}AI 市场简报{% else %}AI Market Brief{% endif %}</div>{% for paragraph in web_report.ai_market_brief %}<p>{{ paragraph }}</p>{% endfor %}</div></section>
<section class="section" id="sources"><div class="section-head"><div><div class="eyebrow">{% if web_primary_zh %}来源 / 数据质量{% else %}Sources / data quality{% endif %}</div><h2>{% if web_primary_zh %}信任状态{% else %}Trust state{% endif %}</h2></div></div><div class="panel"><p>{{ briefing.data_quality.status }} · {{ briefing.data_quality.documents }} documents · {{ briefing.data_quality.events }} events · {{ briefing.data_quality.markets }} market observations · {{ briefing.data_quality.sources_healthy }}/{{ briefing.data_quality.sources_total }} sources healthy.</p>{% if web_report.localization_unavailable %}<div class="unavailable">Localization unavailable · canonical English reference is retained below.</div>{% endif %}{% for gap in web_report.coverage_gaps %}<div class="detail">{{ gap.reason }}</div>{% endfor %}</div></section>
{% if web_include_english_reference %}<section class="section" id="english-reference"><details class="panel"><summary><strong>English reference / 英文原文</strong></summary><p><strong>Market Regime</strong> · {{ web_report.regime.label }}</p><p><strong>Market overview</strong> · {% for item in web_report.market_cards[:8] %}{{ item.label_en }} {{ '%.2f'|format(item.level) }} {{ '%+.2f'|format(item.change_pct) }}%{% if not loop.last %} · {% endif %}{% endfor %}</p>{% for story in briefing.primary_stories[:5] %}<p><strong>{{ story.headline }}</strong><br>{{ story.why_it_matters }}</p>{% endfor %}<p><strong>Cross-asset</strong> · {% for signal in web_report.cross_asset_signals %}{{ signal.code }} — {{ signal.label }}{% if not loop.last %}; {% endif %}{% else %}No validated signal.{% endfor %}</p></details></section>{% endif %}
<section class="section" id="source-links"><div class="panel"><div class="eyebrow">Sources</div>{% for story in briefing.primary_stories[:5] %}{% for source in story.sources %}<a href="{{ source.url }}">{{ source.publisher }}</a>{% if not loop.last %} · {% endif %}{% endfor %}{% endfor %}</div></section>
<div class="compatibility" aria-hidden="true">Global Investment Radar — {{ briefing.report_date }} · Things That Matter · Market Snapshot · Market reaction · AI / Semiconductors · US 2Y Treasury Yield · US 10Y Treasury Yield · No validated linked reaction is available · Driver unresolved · Sources &amp; Data Quality{% if is_demo %} · DEMO DATA{% endif %}{% if briefing.data_quality.ai_status == 'disabled' %} · AI is off{% endif %}{% if ai_test_data %} · TEST AI OUTPUT · Any AI-assisted prose is synthetic{% endif %}{% if not web_report.primary_stories %} · No strong Story met today’s primary threshold{% endif %}{% if 'INSUFFICIENT' in briefing.data_quality.status|upper %} · INSUFFICIENT DATA{% endif %}{% for gap in web_report.coverage_gaps %} · {{ gap.code }}{% endfor %}</div>
<div class="footer">GLOBAL INVESTMENT RADAR · V7 APPLE MARKETS WEB REPORT · EVIDENCE-FIRST</div>
</main></div>
<noscript><p>Interactive controls are unavailable; all validated observations remain readable above.</p></noscript>
<script>
(()=>{const reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;const cards=[...document.querySelectorAll('[data-market-key]')],tabs=[...document.querySelectorAll('[data-trend-key]')],ranges=[...document.querySelectorAll('[data-range]')],paths=[...document.querySelectorAll('[data-trend-path]')];let key=tabs[0]?.dataset.trendKey||'';let range='1D';function draw(){paths.forEach(p=>{p.hidden=!(p.dataset.key===key&&p.dataset.range===range)});tabs.forEach(t=>{const on=t.dataset.trendKey===key;t.classList.toggle('active',on);t.setAttribute('aria-selected',String(on))});ranges.forEach(r=>r.classList.toggle('active',r.dataset.range===range))}cards.forEach(c=>c.addEventListener('click',()=>{cards.forEach(x=>{x.classList.remove('selected');x.setAttribute('aria-pressed','false')});c.classList.add('selected');c.setAttribute('aria-pressed','true');const t=tabs.find(x=>x.dataset.trendKey===c.dataset.marketKey);if(t){key=t.dataset.trendKey;draw()}}));tabs.forEach(t=>t.addEventListener('click',()=>{key=t.dataset.trendKey;draw()}));ranges.forEach(r=>r.addEventListener('click',()=>{range=r.dataset.range;draw()}));paths.forEach(p=>p.addEventListener('pointermove',e=>{const tip=document.querySelector('[data-tooltip]');if(!tip)return;const rect=p.getBoundingClientRect(),points=JSON.parse(p.dataset.points||'[]');if(!points.length)return;const i=Math.max(0,Math.min(points.length-1,Math.round((e.clientX-rect.left)/rect.width*(points.length-1))));tip.textContent=points[i][0]+' · '+Number(points[i][1]).toFixed(2);tip.style.display='block';tip.style.left=Math.min(e.clientX-rect.left+10,rect.width-150)+'px';tip.style.top=Math.max(8,e.clientY-rect.top-34)+'px'}));paths.forEach(p=>p.addEventListener('pointerleave',()=>{const tip=document.querySelector('[data-tooltip]');if(tip)tip.style.display='none'}));if(!reduce)document.documentElement.classList.add('motion-ready');draw()})()
</script>
</body></html>
