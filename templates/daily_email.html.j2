<!doctype html>
<html lang="{% if localized_primary %}zh-CN{% else %}en{% endif %}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if localized_primary %}全球投资雷达{% else %}Global Investment Radar{% endif %} — {{ briefing.report_date }}</title>
</head>
<body style="margin:0;background:#EEF3F7;color:#10243B;font-family:Aptos,'Segoe UI',Arial,sans-serif;">
  <div style="display:none;max-height:0;overflow:hidden;color:transparent;">{% if localized_primary %}全球投资晨报 · {{ briefing.report_date }}{% else %}A focused global intelligence brief for {{ briefing.report_date }}.{% endif %}</div>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width:100%;background:#EEF3F7;border-collapse:collapse;">
    <tr>
      <td align="center" style="padding:18px 10px 34px;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width:100%;max-width:680px;background:#F9FBFC;border-collapse:separate;border-spacing:0;border:1px solid #D8E3EC;border-radius:22px;">
          <tr>
            <td style="padding:30px 28px 26px;background:#10243B;border-radius:21px 21px 0 0;color:#FFFFFF;">
              <div style="font-size:10px;line-height:1.4;letter-spacing:1.7px;text-transform:uppercase;color:#9FC5E3;font-weight:700;">{% if localized_primary %}{{ localization_labels.localized_briefing }}{% else %}Daily Market Intelligence{% endif %} · {{ briefing.view_name }}</div>
              <h1 style="margin:9px 0 7px;font-size:28px;line-height:1.12;font-weight:750;letter-spacing:-.5px;color:#FFFFFF;">{% if localized_primary %}全球投资雷达{% else %}Global Investment Radar{% endif %}</h1>
              <div style="font-size:13px;line-height:1.5;color:#C5D7E6;">{{ briefing.report_date }} · {% if localized_primary %}先看市场正在交易什么，再看新闻{% else %}What markets are trading, before the news queue{% endif %}</div>
            </td>
          </tr>

          {% if is_demo %}<tr><td style="padding:11px 28px;background:#FFF4D9;border-bottom:1px solid #ECD9A5;color:#785A18;font-size:12px;line-height:1.55;"><strong>DEMO DATA</strong> · Synthetic fixtures for pipeline validation; not investment research.</td></tr>{% endif %}
          {% if ai_test_data %}<tr><td style="padding:11px 28px;background:#FCEEEE;border-bottom:1px solid #ECCACA;color:#7A2E2E;font-size:12px;line-height:1.55;"><strong>TEST AI OUTPUT</strong> · Any AI-assisted prose is synthetic.</td></tr>{% elif briefing.ai_status == 'disabled' %}<tr><td style="padding:11px 28px;background:#EAF1F7;border-bottom:1px solid #D6E2EC;color:#40566F;font-size:12px;line-height:1.55;"><strong>AI is off.</strong> Selection, ranking and deterministic signals remain available.</td></tr>{% elif briefing.ai_status in ['failed', 'partial'] %}<tr><td style="padding:11px 28px;background:#FFF4D9;border-bottom:1px solid #ECD9A5;color:#785A18;font-size:12px;line-height:1.55;"><strong>AI enrichment {{ briefing.ai_status }}.</strong> The deterministic brief remains complete.</td></tr>{% endif %}
          {% if briefing.data_quality.status == 'INSUFFICIENT' %}<tr><td style="padding:11px 28px;background:#FCEEEE;border-bottom:1px solid #ECCACA;color:#7A2E2E;font-size:12px;line-height:1.55;"><strong>INSUFFICIENT DATA</strong> · Diagnostic output; normal delivery quality gates should reject it.</td></tr>{% elif briefing.data_quality.status == 'DEGRADED' %}<tr><td style="padding:11px 28px;background:#FFF4D9;border-bottom:1px solid #ECD9A5;color:#785A18;font-size:12px;line-height:1.55;"><strong>DEGRADED DATA</strong> · Read conclusions with additional caution.</td></tr>{% endif %}

          <tr>
            <td style="padding:24px 28px 10px;">
              <div style="font-size:10px;line-height:1.4;letter-spacing:1.35px;text-transform:uppercase;color:#4A7EA5;font-weight:750;">{% if localized_primary %}市场状态 · {% endif %}Market Regime</div>
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width:100%;margin-top:8px;border-collapse:separate;border-spacing:0;background:#EAF2F8;border:1px solid #CFE0ED;border-radius:16px;">
                <tr>
                  <td style="padding:18px 19px;">
                    <div style="font-size:22px;line-height:1.2;color:#10243B;font-weight:750;letter-spacing:.2px;">{{ web_report.regime.label }}</div>
                    <div style="margin-top:6px;font-size:12px;line-height:1.55;color:#577087;">{% if localized_primary %}基于已验证市场观察与跨资产关系；未获证据支持的原因不会写成结论。{% else %}Based on validated observations and cross-asset relationships; unsupported causes are not presented as conclusions.{% endif %}</div>
                    <div style="margin-top:9px;font-size:11px;line-height:1.5;color:#6E8395;">{% if localized_primary %}支持资产{% else %}Supporting assets{% endif %} · {{ web_report.regime.supporting_symbols|join(' / ') or 'Unavailable' }}</div>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <tr><td style="padding:22px 28px 8px;border-top:1px solid #E1E9EF;"><div style="font-size:10px;line-height:1.4;letter-spacing:1.35px;text-transform:uppercase;color:#4A7EA5;font-weight:750;">{% if localized_primary %}全球市场带 · {% endif %}Global Market Strip</div><h2 style="margin:5px 0 0;font-size:19px;line-height:1.25;color:#10243B;">{% if localized_primary %}市场快照{% else %}Market Snapshot{% endif %}</h2></td></tr>
          <tr>
            <td style="padding:0 28px 24px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width:100%;border-collapse:collapse;">
                {% for item in web_report.market_cards[:12] %}
                <tr>
                  <td style="padding:9px 0;border-bottom:1px solid #E8EEF3;font-size:12px;line-height:1.45;color:#294157;">{{ item.label_zh if localized_primary else item.label_en }} <span style="color:#8292A1;">{{ item.provider_symbol }}</span></td>
                  <td align="right" style="padding:9px 9px;border-bottom:1px solid #E8EEF3;font-size:12px;line-height:1.45;color:#10243B;font-family:Consolas,'SFMono-Regular',monospace;white-space:nowrap;">{% if item.level is not none %}{{ '%.2f'|format(item.level) }}{% else %}—{% endif %}</td>
                  <td align="right" style="padding:9px 0;border-bottom:1px solid #E8EEF3;font-size:12px;line-height:1.45;color:{% if item.change_pct is not none and item.change_pct > 0 %}#287255{% elif item.change_pct is not none and item.change_pct < 0 %}#9A514B{% else %}#607384{% endif %};font-family:Consolas,'SFMono-Regular',monospace;font-weight:700;white-space:nowrap;">{% if item.change_pct is not none %}{{ '%+.2f'|format(item.change_pct) }}%{% else %}n/a{% endif %}</td>
                </tr>
                {% else %}<tr><td style="padding:12px 0;color:#748596;font-size:13px;line-height:1.55;">No completed market observation is available.</td></tr>{% endfor %}
              </table>
            </td>
          </tr>

          <tr><td style="padding:23px 28px 8px;border-top:1px solid #E1E9EF;"><div style="font-size:10px;line-height:1.4;letter-spacing:1.35px;text-transform:uppercase;color:#4A7EA5;font-weight:750;">{% if localized_primary %}今日焦点 · {% endif %}Today’s Focus</div><h2 style="margin:5px 0 0;font-size:20px;line-height:1.25;color:#10243B;">{% if localized_primary %}真正值得先读的事项{% else %}Highest-information developments{% endif %}</h2></td></tr>
          {% for item in email_intelligence.focus %}
          {% set translated = localized_primary_stories.get(item.event_id) %}
          <tr>
            <td style="padding:15px 28px 18px;{% if not loop.first %}border-top:1px solid #E8EEF3;{% endif %}">
              <div style="font-size:10px;line-height:1.4;color:#4A7EA5;font-weight:750;letter-spacing:.7px;">{{ '%02d'|format(loop.index) }}</div>
              <h3 style="margin:6px 0 10px;font-size:17px;line-height:1.35;color:#10243B;">{{ translated.headline if localized_primary and translated else item.headline }}</h3>
              <div style="font-size:12px;line-height:1.62;color:#40576C;"><strong style="color:#173149;">{% if localized_primary %}发生了什么{% else %}What happened{% endif %}</strong> · {{ translated.headline if localized_primary and translated else item.what_happened }}</div>
              <div style="margin-top:5px;font-size:12px;line-height:1.62;color:#40576C;"><strong style="color:#173149;">{% if localized_primary %}为什么重要{% else %}Why it matters{% endif %}</strong> · {{ translated.why_it_matters if localized_primary and translated else item.why_it_matters }}</div>
              <div style="margin-top:5px;font-size:12px;line-height:1.62;color:#40576C;"><strong style="color:#173149;">{% if localized_primary %}影响什么{% else %}Affected{% endif %}</strong> · {{ item.affected }}</div>
              {% if item.market_reaction_zh %}<div style="margin-top:5px;font-size:12px;line-height:1.62;color:#40576C;"><strong style="color:#173149;">{% if localized_primary %}市场如何反应{% else %}Market reaction{% endif %}</strong> · {{ item.market_reaction_zh if localized_primary else item.market_reaction_en }}</div>{% endif %}
              <div style="margin-top:5px;font-size:12px;line-height:1.62;color:#6F8293;"><strong style="color:#536A7E;">{% if localized_primary %}仍未知{% else %}Still unknown{% endif %}</strong> · {{ item.unknown_zh if localized_primary else item.unknown_en }}</div>
              {% if item.sources %}<div style="margin-top:9px;font-size:10px;line-height:1.55;color:#7A8B99;">{% if localized_primary %}来源{% else %}Sources{% endif %} · {% for source in item.sources %}<a href="{{ source.url }}" style="color:#356F9B;text-decoration:underline;">{{ source.publisher }}</a>{% if not loop.last %} · {% endif %}{% endfor %}</div>{% endif %}
            </td>
          </tr>
          {% else %}<tr><td style="padding:14px 28px 24px;color:#748596;font-size:13px;line-height:1.55;"><strong>{% if localized_primary %}今日信息密度较低。{% else %}Low-activity brief.{% endif %}</strong> {% if localized_primary %}没有事项同时满足新鲜度、重要性与证据门槛；未用低价值内容填充。{% else %}No item cleared freshness, value and evidence thresholds; no filler was promoted.{% endif %}</td></tr>{% endfor %}

          <tr><td style="padding:23px 28px 8px;border-top:1px solid #E1E9EF;"><div style="font-size:10px;line-height:1.4;letter-spacing:1.35px;text-transform:uppercase;color:#4A7EA5;font-weight:750;">{% if localized_primary %}中国 / A股 · {% endif %}China / A-Shares</div><h2 style="margin:5px 0 0;font-size:19px;line-height:1.25;color:#10243B;">{% if localized_primary %}中国市场结构{% else %}Local market context{% endif %}</h2></td></tr>
          <tr><td style="padding:0 28px 23px;">
            {% if web_report.china.indices %}
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width:100%;border-collapse:collapse;">{% for item in web_report.china.indices[:8] %}<tr><td style="padding:7px 0;border-bottom:1px solid #E8EEF3;font-size:12px;color:#294157;">{{ item.name }} <span style="color:#8292A1;">{{ item.symbol }}</span></td><td align="right" style="padding:7px 8px;border-bottom:1px solid #E8EEF3;font-size:12px;color:#10243B;font-family:Consolas,'SFMono-Regular',monospace;">{{ '%.2f'|format(item.close) }}</td><td align="right" style="padding:7px 0;border-bottom:1px solid #E8EEF3;font-size:12px;color:{% if item.change_pct > 0 %}#287255{% elif item.change_pct < 0 %}#9A514B{% else %}#607384{% endif %};font-family:Consolas,'SFMono-Regular',monospace;font-weight:700;">{{ '%+.2f'|format(item.change_pct) }}%</td></tr>{% endfor %}</table>
            {% else %}<div style="padding:11px 0;color:#748596;font-size:12px;line-height:1.55;">Core index data unavailable; no demo values were inserted.</div>{% endif %}
            {% if web_report.china.sectors %}
            <div style="margin-top:16px;font-size:12px;line-height:1.4;color:#294157;font-weight:750;">Sector ranking · Top / Bottom</div>
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width:100%;margin-top:5px;border-collapse:collapse;">
              {% for sector in web_report.china.sectors[:8] %}{% set bar_width = [sector.change_1d|abs * 14, 100]|min %}
              <tr>
                <td width="27%" style="padding:6px 8px 6px 0;font-size:11px;color:#40576C;">{{ sector.sector }}</td>
                <td width="55%" style="padding:6px 8px;"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width:100%;border-collapse:collapse;background:#E3EBF1;"><tr><td width="{{ bar_width|int }}%" height="7" style="height:7px;background:{% if sector.change_1d >= 0 %}#69A88D{% else %}#C6837D{% endif %};font-size:1px;line-height:1px;">&nbsp;</td><td height="7" style="height:7px;font-size:1px;line-height:1px;">&nbsp;</td></tr></table></td>
                <td width="18%" align="right" style="padding:6px 0;font-size:11px;color:{% if sector.change_1d >= 0 %}#287255{% else %}#9A514B{% endif %};font-family:Consolas,'SFMono-Regular',monospace;font-weight:700;white-space:nowrap;">{{ '%+.2f'|format(sector.change_1d) }}%</td>
              </tr>
              {% endfor %}
            </table>
            <div style="margin-top:8px;font-size:11px;line-height:1.55;color:#748596;">Top / Bottom · {{ web_report.china.sectors[0].sector }} / {{ web_report.china.sectors[-1].sector }} · Sector advance/decline {{ web_report.china.breadth[0] }}/{{ web_report.china.breadth[1] }} · Leadership {{ web_report.china.leadership or 'Unavailable' }} · Provider {{ web_report.china_capabilities.source or 'Unavailable' }}</div>
            {% else %}<div style="margin-top:10px;font-size:12px;line-height:1.55;color:#748596;">Sector ranking appears only when structured sector observations are available.</div>{% endif %}
            {% if web_report.china_capabilities.unavailable %}<div style="margin-top:7px;font-size:10px;line-height:1.5;color:#8A7352;">Unavailable · {{ web_report.china_capabilities.unavailable|join(' / ') }}</div>{% endif %}
          </td></tr>

          <tr><td style="padding:23px 28px 8px;border-top:1px solid #E1E9EF;"><div style="font-size:10px;line-height:1.4;letter-spacing:1.35px;text-transform:uppercase;color:#4A7EA5;font-weight:750;">{% if localized_primary %}波动率与利率 · {% endif %}Volatility &amp; Rates</div><h2 style="margin:5px 0 0;font-size:19px;line-height:1.25;color:#10243B;">VIX / VXN / Rates / WTI</h2></td></tr>
          <tr><td style="padding:0 28px 23px;">
            {% for context in web_report.multi_day if context.symbol in ['^VIX', '^VXN', '^IRX', '^FVX', '^TNX', 'US_2Y', 'US_10Y', 'CL=F'] or context.name in ['VIX', 'VXN', 'US 2Y Treasury', 'US 10Y Treasury', 'WTI Crude'] %}
            {% set observation = namespace(value=none) %}{% for market in web_report.market_observations %}{% if market.symbol == context.symbol %}{% set observation.value = market %}{% endif %}{% endfor %}
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width:100%;margin-top:7px;border-collapse:separate;border-spacing:0;background:#F3F7FA;border:1px solid #DFE8EF;border-radius:11px;">
              <tr>
                <td style="padding:11px 12px;"><div style="font-size:12px;color:#173149;font-weight:750;">{{ context.name }}</div><div style="margin-top:3px;font-size:10px;line-height:1.45;color:#748596;">{{ context.symbol }} · {{ context.regime }}</div></td>
                <td align="right" style="padding:11px 7px;font-family:Consolas,'SFMono-Regular',monospace;"><div style="font-size:13px;color:#10243B;font-weight:700;">{{ '%.2f'|format(context.close) }}</div><div style="margin-top:3px;font-size:10px;color:{% if context.change_1d >= 0 %}#287255{% else %}#9A514B{% endif %};">1D {{ '%+.2f'|format(context.change_1d) }}%</div></td>
                <td align="right" style="padding:11px 7px;font-size:10px;line-height:1.7;color:#607384;font-family:Consolas,'SFMono-Regular',monospace;white-space:nowrap;">5D {% if context.change_5d is not none %}{{ '%+.2f'|format(context.change_5d) }}%{% else %}n/a{% endif %}<br>7D {% if context.change_7d is not none %}{{ '%+.2f'|format(context.change_7d) }}%{% else %}n/a{% endif %}</td>
                <td align="right" width="88" style="padding:10px 11px 10px 4px;vertical-align:bottom;">
                  {% if observation.value and observation.value.history|length >= 7 %}{% set closes = observation.value.history[:7]|map(attribute='close')|list %}{% set low = closes|min %}{% set high = closes|max %}{% set spread = high - low %}
                  <table role="presentation" width="76" height="28" cellpadding="0" cellspacing="0" style="width:76px;height:28px;border-collapse:separate;border-spacing:2px;"> <tr>{% for point in observation.value.history[:7]|reverse %}{% set height = 5 if spread == 0 else 5 + ((point.close - low) / spread * 21)|int %}<td valign="bottom" style="vertical-align:bottom;"><div style="height:{{ height }}px;background:#6AA8D8;border-radius:2px 2px 0 0;font-size:1px;line-height:1px;">&nbsp;</div></td>{% endfor %}</tr></table>
                  {% else %}<span style="font-size:9px;color:#97A5B1;">7-day history unavailable</span>{% endif %}
                </td>
              </tr>
            </table>
            {% else %}<div style="padding:11px 0;color:#748596;font-size:12px;line-height:1.55;">Risk and rates observations are unavailable; no visual was fabricated.</div>{% endfor %}
            <div style="margin-top:11px;padding:10px 12px;background:#EAF2F8;border-left:3px solid #6AA8D8;font-size:11px;line-height:1.55;color:#486176;">Fed repricing → rates → equities is presented as transmission context. Observed co-movement is associated, not causal, unless evidence explicitly supports a driver.</div>
          </td></tr>

          <tr><td style="padding:23px 28px 8px;border-top:1px solid #E1E9EF;"><div style="font-size:10px;line-height:1.4;letter-spacing:1.35px;text-transform:uppercase;color:#4A7EA5;font-weight:750;">{% if localized_primary %}市场信号 · {% endif %}Market Signals</div><h2 style="margin:5px 0 0;font-size:19px;line-height:1.25;color:#10243B;">{% if localized_primary %}数字、解释与未知{% else %}Observation, interpretation and unknown{% endif %}</h2></td></tr>
          {% for signal in email_intelligence.market_signals %}<tr><td style="padding:8px 28px 13px;"><div style="font-size:13px;line-height:1.45;color:#173149;font-weight:700;">{{ signal.title_zh if localized_primary else signal.title_en }}</div><div style="margin-top:4px;font-size:12px;line-height:1.58;color:#40576C;"><strong>{% if localized_primary %}观察{% else %}Observed{% endif %}</strong> · {{ signal.observed }}<br><strong>{% if localized_primary %}解读{% else %}Interpretation{% endif %}</strong> · {{ signal.interpretation_zh if localized_primary else signal.interpretation_en }}<br><strong>{% if localized_primary %}未知{% else %}Unknown{% endif %}</strong> · {{ signal.unknown_zh if localized_primary else signal.unknown_en }}</div></td></tr>{% else %}<tr><td style="padding:7px 28px 20px;color:#748596;font-size:12px;line-height:1.55;">{% if localized_primary %}没有达到异常或分化阈值的独立市场信号。{% else %}No distinct market signal cleared the abnormality or divergence threshold.{% endif %}</td></tr>{% endfor %}

          <tr><td style="padding:23px 28px 8px;border-top:1px solid #E1E9EF;"><div style="font-size:10px;line-height:1.4;letter-spacing:1.35px;text-transform:uppercase;color:#4A7EA5;font-weight:750;">{% if localized_primary %}接下来关注 · {% endif %}What Matters Next</div></td></tr>
          {% for item in email_intelligence.next_catalysts %}<tr><td style="padding:7px 28px 12px;font-size:12px;line-height:1.55;color:#40576C;"><strong style="color:#173149;">{{ localized_watch_items[item.event_id].headline if localized_primary and localized_watch_items.get(item.event_id) else item.title }}</strong><br>{{ localized_watch_items[item.event_id].text if localized_primary and localized_watch_items.get(item.event_id) else item.trigger }}</td></tr>{% else %}<tr><td style="padding:7px 28px 20px;color:#748596;font-size:12px;line-height:1.55;">{% if localized_primary %}没有得到验证的未来催化剂；系统不会用旧新闻或泛泛的“继续观察”填充。{% else %}No validated future catalyst is available; stale news and generic monitoring text are not used as filler.{% endif %}</td></tr>{% endfor %}

          <tr><td style="padding:23px 28px 8px;border-top:1px solid #E1E9EF;"><div style="font-size:10px;line-height:1.4;letter-spacing:1.35px;text-transform:uppercase;color:#4A7EA5;font-weight:750;">{% if localized_primary %}次要进展 · {% endif %}Secondary Developments</div><h2 style="margin:5px 0 0;font-size:19px;line-height:1.25;color:#10243B;">{% if localized_primary %}雷达之下{% else %}Under the Radar{% endif %}</h2></td></tr>
          {% for item in briefing.under_radar %}{% set translated_under_radar = localized_under_radar.get(item.event_id) %}<tr><td style="padding:7px 28px 11px;font-size:12px;line-height:1.55;color:#40576C;"><strong style="color:#173149;">{{ translated_under_radar.headline if localized_primary and translated_under_radar else item.headline }}</strong><br>{{ translated_under_radar.note if localized_primary and translated_under_radar else item.note }}</td></tr>{% endfor %}
          {% for item in web_report.decayed_stories %}{% set freshness = web_report.freshness.get(item.event_id) %}{% set translated_decayed = localized_primary_stories.get(item.event_id) %}<tr><td style="padding:7px 28px 11px;font-size:12px;line-height:1.55;color:#40576C;"><strong style="color:#173149;">{{ translated_decayed.headline if localized_primary and translated_decayed else item.headline }}</strong><br><span style="font-size:10px;color:#8A7352;">{% if localized_primary %}信息增量不足，已降为次要；此前排名 #{{ freshness.previous_rank if freshness else '?' }}。{% else %}{{ freshness.decision if freshness else 'DEMOTE_SECONDARY' }} · {{ freshness.decay_reason if freshness else 'No new information gain.' }} · previous #{{ freshness.previous_rank if freshness else '?' }} → Secondary / Decayed{% endif %}</span></td></tr>{% endfor %}
          {% if not briefing.under_radar and not web_report.decayed_stories %}<tr><td style="padding:7px 28px 20px;color:#748596;font-size:12px;line-height:1.55;">{% if localized_primary %}没有其他事项达到保守的次级阈值。{% else %}No additional item cleared the conservative secondary threshold.{% endif %}</td></tr>{% endif %}

          <tr><td style="padding:22px 28px;border-top:1px solid #E1E9EF;background:#10243B;color:#EAF2F8;"><div style="font-size:10px;line-height:1.4;letter-spacing:1.35px;text-transform:uppercase;color:#9FC5E3;font-weight:750;">{% if localized_primary %}AI 市场简报 · {% endif %}AI Market Brief</div>{% for paragraph in (email_intelligence.market_brief_zh if localized_primary else email_intelligence.market_brief_en) %}<div style="margin-top:9px;font-size:13px;line-height:1.62;color:#EAF2F8;">{{ paragraph }}</div>{% endfor %}</td></tr>
          {% if note_text %}<tr><td style="padding:17px 28px;background:#EAF2F8;border-top:1px solid #D7E3EC;font-size:12px;line-height:1.6;color:#40576C;white-space:pre-line;"><strong>Editor's Note / 今日附言</strong><br>{{ note_text }}</td></tr>{% endif %}

          {% if include_english_reference %}
          <tr><td lang="en" style="padding:23px 28px 8px;border-top:3px solid #C9D9E5;"><div style="font-size:10px;line-height:1.4;letter-spacing:1.35px;text-transform:uppercase;color:#4A7EA5;font-weight:750;">English reference / 英文原文</div><h2 style="margin:5px 0 0;font-size:19px;line-height:1.25;color:#10243B;">Global Investment Radar</h2></td></tr>
          <tr><td lang="en" style="padding:7px 28px 10px;font-size:12px;line-height:1.55;color:#40576C;"><strong>Market Regime</strong> · {{ web_report.regime.label }}<br><strong>Headline references</strong></td></tr>
          {% for item in email_intelligence.focus %}<tr><td lang="en" style="padding:8px 28px 12px;font-size:12px;line-height:1.58;color:#40576C;"><strong style="color:#173149;">{{ item.headline }}</strong>{% if item.sources %}<br><span style="font-size:10px;color:#7A8B99;">{% for source in item.sources %}<a href="{{ source.url }}" style="color:#356F9B;text-decoration:underline;">{{ source.publisher }}</a>{% if not loop.last %} · {% endif %}{% endfor %}</span>{% endif %}</td></tr>{% endfor %}
          {% endif %}

          <tr><td style="padding:23px 28px 27px;border-top:1px solid #E1E9EF;background:#E8F0F6;border-radius:0 0 21px 21px;">
            <div style="font-size:10px;line-height:1.4;letter-spacing:1.2px;text-transform:uppercase;color:#4A7EA5;font-weight:750;">{% if localized_primary %}来源与数据质量 · {% endif %}Sources &amp; Data Quality</div>
            <div style="margin-top:8px;font-size:11px;line-height:1.65;color:#596F82;">{{ briefing.data_quality.status }} · {{ briefing.data_quality.documents }} documents · {{ briefing.data_quality.events }} Events · {{ briefing.data_quality.markets }} market observations<br>{{ briefing.data_quality.sources_healthy }}/{{ briefing.data_quality.sources_total }} sources healthy · AI {{ briefing.data_quality.ai_status }} · Validated reaction coverage {% if briefing.data_quality.has_validated_market_reactions %}present{% else %}absent{% endif %}</div>
            {% for gap in web_report.coverage_gaps %}<div style="margin-top:6px;font-size:10px;line-height:1.5;color:#8A7352;">{{ gap.reason }}</div>{% endfor %}
            <div style="margin-top:13px;font-size:9px;line-height:1.55;color:#7D8D9A;">Evidence-linked intelligence, not investment advice. Market reactions are observational: associated, not causal. Email uses static, client-safe visuals.</div>
          </td></tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
