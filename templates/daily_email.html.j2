<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Global Investment Radar — {{ report_date }}</title>
</head>
<body style="margin:0;background:#f4f6f8;color:#17202a;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;">
  <div style="display:none;max-height:0;overflow:hidden;color:transparent;">
    Evidence-first market, macro and event briefing for {{ report_date }}.
  </div>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f6f8;border-collapse:collapse;">
    <tr><td align="center" style="padding:24px 10px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:720px;background:#ffffff;border-collapse:collapse;border:1px solid #dfe4e8;">
        <tr>
          <td style="padding:26px 26px 18px;background:#132238;color:#ffffff;">
            <div style="font-size:12px;letter-spacing:1.4px;text-transform:uppercase;color:#a9bad0;">Evidence-first daily research</div>
            <h1 style="margin:8px 0 4px;font-size:26px;line-height:1.2;">Global Investment Radar</h1>
            <div style="font-size:15px;color:#d8e1eb;">{{ report_date }} · No-AI capable pipeline</div>
          </td>
        </tr>

        {% if is_demo %}
        <tr><td style="padding:14px 26px;background:#fff3cd;color:#6f5200;font-size:14px;line-height:1.5;border-bottom:1px solid #efd98b;">
          <strong>DEMO DATA:</strong> This report contains synthetic fixtures. It validates the pipeline and must not be used as investment research.
        </td></tr>
        {% endif %}
        {% if ai_test_data %}
        <tr><td style="padding:14px 26px;background:#fde8e8;color:#7b2020;font-size:14px;line-height:1.5;border-bottom:1px solid #efb5b5;">
          <strong>TEST AI OUTPUT:</strong> FakeLLMProvider is active. Every AI paragraph below is synthetic test data.
        </td></tr>
        {% elif ai_status == 'disabled' %}
        <tr><td style="padding:12px 26px;background:#edf3f8;color:#40566f;font-size:13px;line-height:1.5;border-bottom:1px solid #d9e3ec;">
          AI analysis is disabled or unavailable. All summaries and rankings in this report were generated deterministically.
        </td></tr>
        {% endif %}

        {% if quality.status.value == 'INSUFFICIENT' %}
        <tr><td style="padding:16px 26px;background:#fde8e8;color:#7b2020;font-size:14px;line-height:1.5;border-bottom:1px solid #efb5b5;">
          <strong>INSUFFICIENT DATA:</strong> This is a diagnostic report, not a normal morning brief.
          {% for reason in quality.reasons %}<div style="margin-top:4px;">{{ reason }}</div>{% endfor %}
        </td></tr>
        {% elif quality.status.value == 'DEGRADED' %}
        <tr><td style="padding:14px 26px;background:#fff3cd;color:#6f5200;font-size:13px;line-height:1.5;border-bottom:1px solid #efd98b;">
          <strong>DEGRADED DATA:</strong>
          {% for reason in quality.reasons %}{{ reason }}{% if not loop.last %} {% endif %}{% endfor %}
        </td></tr>
        {% endif %}

        <tr><td style="padding:22px 26px 8px;">
          <h2 style="margin:0 0 10px;font-size:19px;color:#132238;">Run health</h2>
          {% for status in provider_statuses %}
          <div style="padding:8px 0;border-top:1px solid #edf0f2;font-size:13px;line-height:1.45;">
            <strong>{{ status.provider }}</strong> · {{ status.status }} · {{ status.item_count }} items
            {% for warning in status.warnings %}<div style="color:#697887;margin-top:3px;">{{ warning }}</div>{% endfor %}
          </div>
          {% endfor %}
        </td></tr>

        <tr><td style="padding:20px 26px 8px;">
          <h2 style="margin:0 0 10px;font-size:19px;color:#132238;">Data Coverage</h2>
          <div style="font-size:13px;line-height:1.7;color:#4c5b68;">
            Market observations {{ coverage.markets }} · Macro observations {{ coverage.macro }} ·
            Source documents {{ coverage.documents }} · Events {{ coverage.events }}
          </div>
          <h3 style="margin:14px 0 5px;font-size:14px;color:#25384d;">Freshness</h3>
          <div style="font-size:13px;line-height:1.7;color:#667583;">
            Latest market: {{ freshness.latest_market_at.isoformat() if freshness.latest_market_at else 'unavailable' }}<br>
            Latest source: {{ freshness.latest_source_at.isoformat() if freshness.latest_source_at else 'unavailable' }}<br>
            Latest macro period: {{ freshness.latest_macro_period or 'unavailable' }}
          </div>
          <h3 style="margin:14px 0 5px;font-size:14px;color:#25384d;">Missing Data</h3>
          {% for note in missing_data %}
          <div style="padding:4px 0;font-size:13px;line-height:1.5;color:#7a5b28;">{{ note }}</div>
          {% endfor %}
          {% if not missing_data %}
          <div style="font-size:13px;color:#527261;">No missing category or provider failure was detected.</div>
          {% endif %}
        </td></tr>

        <tr><td style="padding:20px 26px 8px;">
          <h2 style="margin:0 0 6px;font-size:19px;color:#132238;">Overnight Market</h2>
          <p style="margin:0 0 12px;color:#4c5b68;font-size:14px;line-height:1.55;">{{ summary.market_headline }}</p>
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;font-size:14px;">
            {% for item in summary.market_leaders %}
            <tr>
              <td style="padding:9px 6px;border-top:1px solid #edf0f2;">{{ item.name }}</td>
              <td align="right" style="padding:9px 6px;border-top:1px solid #edf0f2;color:#596875;">{{ '%.2f'|format(item.close) }}</td>
              <td align="right" style="padding:9px 6px;border-top:1px solid #edf0f2;font-weight:700;color:{% if item.change_pct >= 0 %}#147a52{% else %}#b13a3a{% endif %};">{{ '%+.2f'|format(item.change_pct) }}%</td>
            </tr>
            {% endfor %}
          </table>
          {% if not summary.market_leaders %}
          <div style="padding:12px 0;color:#7a8793;font-size:14px;">No validated market data was available.</div>
          {% endif %}
        </td></tr>

        <tr><td style="padding:22px 26px 8px;">
          <h2 style="margin:0 0 12px;font-size:19px;color:#132238;">Top Global Events</h2>
          {% for event in events %}
          <div style="padding:16px 0;border-top:1px solid #dfe4e8;">
            <div style="font-size:11px;letter-spacing:.7px;text-transform:uppercase;color:#6a7c8f;">{{ event.event_type.value }} · Importance {{ '%.1f'|format(event.importance_score) }}/100</div>
            <h3 style="margin:6px 0 8px;font-size:16px;line-height:1.4;color:#17202a;">{{ event.title }}</h3>
            <div style="font-size:13px;color:#667583;line-height:1.5;">
              Evidence {{ event.evidence_ids|length }} · Confidence {{ '%.0f'|format(event.confidence * 100) }}%
            </div>
            <div style="margin-top:8px;font-size:13px;line-height:1.55;color:#4e5e6d;">
              {% for document_id in event.source_document_ids %}
                {% set source = sources[document_id] %}
                <a href="{{ source.canonical_url }}" style="color:#245d93;text-decoration:underline;">{{ source.publisher }}</a>{% if not loop.last %} · {% endif %}
              {% endfor %}
              {% for evidence_id in event.evidence_ids %}
                {% set item = evidence[evidence_id] %}
                {% if item.source_kind.value == 'MARKET_OBSERVATION' %}
                  <div style="margin-top:5px;">
                    {{ item.locator.asset }} ({{ item.locator.symbol }}) ·
                    Previous {{ '%.6g'|format(item.locator.previous_close) }} ·
                    Latest {{ '%.6g'|format(item.locator.latest_close) }} ·
                    {{ '%+.2f'|format(item.locator.change_pct) }}% ·
                    {{ item.locator.observed_at }} · {{ item.locator.provider }}
                  </div>
                {% elif item.source_kind.value == 'MACRO_OBSERVATION' %}
                  <div style="margin-top:5px;">
                    {{ item.locator.series }} ({{ item.locator.series_id }}) ·
                    Period {{ item.locator.period }} · Value {{ item.locator.value }} {{ item.locator.unit }}
                    {% if item.locator.previous_value is not none %} · Previous {{ item.locator.previous_value }}{% endif %}
                    {% if item.locator.change is not none %} · Change {{ '%+g'|format(item.locator.change) }} {{ item.locator.change_unit }} {{ item.locator.change_label }}{% endif %}
                    · first observed by Radar {{ item.locator.radar_observed_at }} · {{ item.locator.provider }}
                  </div>
                {% endif %}
              {% endfor %}
            </div>
            {% if event.event_type.value in ['market_move', 'risk'] %}
            <div style="margin-top:12px;padding:12px;background:#f5f8fb;font-size:13px;line-height:1.55;color:#33485e;">
              <strong>Possible drivers</strong>
              {% set bundle = explanation_bundles.get(event.id) %}
              {% set candidates = bundle.driver_candidates if bundle else [] %}
              {% for candidate in candidates %}
              <div style="margin-top:8px;">
                {{ claims[candidate.interpretation_claim_id].text }}
                <div style="margin-top:3px;color:#667583;">
                  Confidence {{ candidate.confidence.value }} ·
                  {{ candidate.temporal_relation.value|replace('_', ' ')|title }} ·
                  {{ candidate.relevance_relation.value|replace('_', ' ')|title }}
                </div>
                <div style="margin-top:3px;">
                  Provenance:
                  {% for evidence_id in candidate.candidate_evidence_ids %}
                    {% set candidate_evidence = evidence[evidence_id] %}
                    {% if candidate_evidence.source_kind.value == 'DOCUMENT' %}
                      {% set candidate_source = sources[candidate_evidence.source_id] %}
                      <a href="{{ candidate_source.canonical_url }}" style="color:#245d93;text-decoration:underline;">{{ candidate_source.publisher }}</a>{% if not loop.last %} · {% endif %}
                    {% endif %}
                  {% endfor %}
                </div>
              </div>
              {% endfor %}
              {% if not candidates %}
              <div style="margin-top:6px;color:#667583;">No evidence-backed driver identified.</div>
              {% endif %}
            </div>
            {% set context_items = cross_asset_context.get(event.id, []) %}
            {% if context_items %}
            <div style="margin-top:10px;font-size:13px;line-height:1.55;color:#4e5e6d;">
              <strong>Cross-asset context</strong>
              {% for item in context_items %}<div style="margin-top:5px;">{{ item.text }}</div>{% endfor %}
            </div>
            {% endif %}
            {% set backdrop_items = macro_backdrop.get(event.id, []) %}
            {% if backdrop_items %}
            <div style="margin-top:10px;font-size:13px;line-height:1.55;color:#4e5e6d;">
              <strong>Macro backdrop</strong>
              {% for item in backdrop_items %}<div style="margin-top:5px;">{{ item.text }}</div>{% endfor %}
            </div>
            {% endif %}
            {% endif %}
            {% set analysis = analyses.get(event.id) %}
            {% if analysis and analysis.why_it_matters %}
            <div style="margin-top:12px;padding:12px;background:#f5f8fb;font-size:14px;line-height:1.55;">
              <strong>AI analysis{% if analysis.is_test_data %} — TEST DATA{% endif %}:</strong> {{ analysis.why_it_matters }}
              <div style="margin-top:6px;"><strong>Bull:</strong> {{ analysis.bull_case }}</div>
              <div style="margin-top:4px;"><strong>Bear:</strong> {{ analysis.bear_case }}</div>
            </div>
            {% endif %}
          </div>
          {% endfor %}
          {% if not events %}
          <div style="padding:12px 0;color:#7a8793;font-size:14px;">No event passed the deterministic extraction stage.</div>
          {% endif %}
        </td></tr>

        <tr><td style="padding:22px 26px 8px;">
          <h2 style="margin:0 0 10px;font-size:19px;color:#132238;">Macro</h2>
          {% for headline in summary.macro_headlines %}
          <div style="padding:9px 0;border-top:1px solid #edf0f2;font-size:14px;line-height:1.45;">{{ headline }}</div>
          {% endfor %}
          {% if not summary.macro_headlines %}
          <div style="padding:12px 0;color:#7a8793;font-size:14px;">No validated macro observations were available.</div>
          {% endif %}
        </td></tr>

        <tr><td style="padding:22px 26px 26px;">
          <h2 style="margin:0 0 10px;font-size:19px;color:#132238;">Risk Radar</h2>
          {% for flag in summary.risk_flags %}
          <div style="padding:9px 0;border-top:1px solid #edf0f2;font-size:14px;line-height:1.45;">{{ flag }}</div>
          {% endfor %}
        </td></tr>

        <tr><td style="padding:18px 26px;background:#f5f7f9;color:#71808e;font-size:11px;line-height:1.55;border-top:1px solid #dfe4e8;">
          Generated {{ generated_at.isoformat() }} · Run {{ run_id }} · Mode {{ data_mode }}.<br>
          Research support only. No content in this report is investment advice. Source links and freshness should be verified before use.
        </td></tr>
      </table>
    </td></tr>
  </table>
</body>
</html>
