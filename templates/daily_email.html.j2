<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Global Investment Radar — {{ briefing.report_date }}</title>
</head>
<body style="margin:0;background:#F7F8FA;color:#14243A;font-family:Aptos,'Segoe UI',Arial,sans-serif;">
  <div style="display:none;max-height:0;overflow:hidden;color:transparent;">A focused global intelligence brief for {{ briefing.report_date }}.</div>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width:100%;background:#F7F8FA;border-collapse:collapse;">
    <tr>
      <td align="center" style="padding:20px 10px 32px;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width:100%;max-width:680px;background:#FFFFFF;border-collapse:collapse;">
          <tr>
            <td style="padding:28px 26px 22px;border-top:5px solid #285A8E;">
              <div style="font-size:11px;line-height:1.3;letter-spacing:1.5px;text-transform:uppercase;color:#285A8E;font-weight:700;">Daily Intelligence · {{ briefing.view_name }}</div>
              <h1 style="margin:9px 0 5px;font-size:27px;line-height:1.14;font-weight:700;color:#14243A;">Global Investment Radar</h1>
              <div style="font-size:14px;line-height:1.5;color:#5E6C7B;">{{ briefing.report_date }} · Signal before volume</div>
            </td>
          </tr>

          {% if is_demo %}
          <tr><td style="padding:11px 26px;background:#FFF6DF;color:#785A18;font-size:12px;line-height:1.55;border-top:1px solid #EAD9A7;"><strong>DEMO DATA</strong> · Synthetic fixtures for pipeline validation; not investment research.</td></tr>
          {% endif %}
          {% if ai_test_data %}
          <tr><td style="padding:11px 26px;background:#FCEEEE;color:#7A2E2E;font-size:12px;line-height:1.55;border-top:1px solid #ECCACA;"><strong>TEST AI OUTPUT</strong> · Any AI-assisted prose is synthetic.</td></tr>
          {% elif briefing.ai_status == 'disabled' %}
          <tr><td style="padding:11px 26px;background:#EEF3F8;color:#40566F;font-size:12px;line-height:1.55;border-top:1px solid #D9E0E7;"><strong>AI is off.</strong> Selection, ordering and explanations remain complete and deterministic.</td></tr>
          {% elif briefing.ai_status in ['failed', 'partial'] %}
          <tr><td style="padding:11px 26px;background:#FFF6DF;color:#785A18;font-size:12px;line-height:1.55;border-top:1px solid #EAD9A7;"><strong>AI enrichment {{ briefing.ai_status }}.</strong> The deterministic brief remains complete.</td></tr>
          {% endif %}

          {% if briefing.data_quality.status == 'INSUFFICIENT' %}
          <tr><td style="padding:12px 26px;background:#FCEEEE;color:#7A2E2E;font-size:12px;line-height:1.55;border-top:1px solid #ECCACA;"><strong>INSUFFICIENT DATA</strong> · This is a diagnostic brief; the normal delivery quality gate will reject it.</td></tr>
          {% elif briefing.data_quality.status == 'DEGRADED' %}
          <tr><td style="padding:12px 26px;background:#FFF6DF;color:#785A18;font-size:12px;line-height:1.55;border-top:1px solid #EAD9A7;"><strong>DEGRADED DATA</strong> · Read conclusions with additional caution.</td></tr>
          {% endif %}

          <tr>
            <td style="padding:16px 26px 8px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width:100%;border-collapse:collapse;background:#14243A;">
                <tr><td style="padding:22px 22px 20px;color:#FFFFFF;">
                  <div style="font-size:11px;line-height:1.3;letter-spacing:1.4px;text-transform:uppercase;color:#AFC4D9;font-weight:700;">Overnight in 30 Seconds</div>
                  {% if briefing.overnight %}
                    {% for item in briefing.overnight %}
                    <div style="padding-top:{% if loop.first %}13{% else %}10{% endif %}px;font-size:14px;line-height:1.55;color:#F3F6F9;">{{ loop.index }}. {{ item.text }}</div>
                    {% endfor %}
                  {% else %}
                  <div style="padding-top:13px;font-size:16px;line-height:1.5;color:#FFFFFF;font-weight:600;">Low-activity brief</div>
                  <div style="padding-top:5px;font-size:13px;line-height:1.55;color:#C7D5E3;">No strong Story met today’s primary threshold. No filler was promoted.</div>
                  {% endif %}
                </td></tr>
              </table>
            </td>
          </tr>

          <tr><td style="padding:26px 26px 5px;">
            <h2 style="margin:0;font-size:20px;line-height:1.25;color:#14243A;">Things That Matter</h2>
            <div style="margin-top:6px;font-size:12px;line-height:1.5;color:#74808D;">Objective importance, then relevance to {{ briefing.view_name }}.</div>
          </td></tr>
          {% for story in briefing.primary_stories %}
          <tr><td style="padding:17px 26px 19px;border-top:1px solid #D9E0E7;">
            <div style="font-size:10px;line-height:1.4;letter-spacing:1px;text-transform:uppercase;color:#285A8E;font-weight:700;">{{ story.priority_band.value|replace('_', ' ') }} · {{ story.importance_band.value }} importance · {{ story.relevance_band.value }} relevance{% if story.region %} · {{ story.region }}{% endif %}</div>
            <h3 style="margin:7px 0 11px;font-size:18px;line-height:1.35;color:#14243A;font-weight:700;">{{ story.headline }}</h3>
            <div style="font-size:12px;line-height:1.4;color:#74808D;font-weight:700;text-transform:uppercase;letter-spacing:.5px;">Why it matters</div>
            <div style="margin-top:4px;font-size:14px;line-height:1.62;color:#33465A;">{{ story.why_it_matters }}</div>
            {% for reaction in story.market_reactions %}
            <div style="margin-top:11px;padding:9px 11px;border-left:3px solid #246B4A;background:#F2F7F4;font-size:12px;line-height:1.55;color:#315343;">
              {{ reaction.summary }}<br><span style="color:#607566;">Association {{ reaction.association_confidence.value }}</span>{% if reaction.uncertainty %}<br><span style="color:#725B2B;">{{ reaction.uncertainty }}</span>{% endif %}
            </div>
            {% endfor %}
            {% if story.sources %}
            <div style="margin-top:12px;font-size:11px;line-height:1.55;color:#74808D;">{{ story.evidence_label }} · {% for source in story.sources %}{{ source.category.value|replace('_', ' ')|title }}: <a href="{{ source.url }}" style="color:#285A8E;text-decoration:underline;">{{ source.publisher }}</a>{% if not loop.last %} · {% endif %}{% endfor %}{% if story.supporting_source_count %} · +{{ story.supporting_source_count }} supporting{% endif %}</div>
            {% endif %}
          </td></tr>
          {% endfor %}
          {% if not briefing.primary_stories %}
          <tr><td style="padding:16px 26px 22px;border-top:1px solid #D9E0E7;font-size:14px;line-height:1.6;color:#5E6C7B;">No strong Story met today’s primary threshold.</td></tr>
          {% endif %}

          <tr><td style="padding:27px 26px 7px;border-top:1px solid #D9E0E7;"><h2 style="margin:0;font-size:19px;line-height:1.3;color:#14243A;">Market Reaction</h2></td></tr>
          {% if briefing.market_reactions %}
            {% for reaction in briefing.market_reactions %}
            <tr><td style="padding:9px 26px;font-size:13px;line-height:1.55;color:#33465A;"><strong>{{ reaction.target_symbol }}</strong> · {{ reaction.summary }}{% if reaction.uncertainty %}<br><span style="color:#8A6423;">{{ reaction.uncertainty }}</span>{% endif %}</td></tr>
            {% endfor %}
          {% else %}
          <tr><td style="padding:9px 26px 20px;font-size:13px;line-height:1.55;color:#74808D;">No validated linked reaction is available for today’s selected Stories.</td></tr>
          {% endif %}

          <tr><td style="padding:25px 26px 7px;border-top:1px solid #D9E0E7;"><h2 style="margin:0;font-size:19px;line-height:1.3;color:#14243A;">Under the Radar</h2></td></tr>
          {% if briefing.under_radar %}
            {% for item in briefing.under_radar %}
            <tr><td style="padding:9px 26px 12px;font-size:13px;line-height:1.55;color:#33465A;"><strong>{{ item.headline }}</strong><br><span style="color:#74808D;">{{ item.note }}</span></td></tr>
            {% endfor %}
          {% else %}
          <tr><td style="padding:9px 26px 20px;font-size:13px;line-height:1.55;color:#74808D;">No additional item cleared the conservative secondary threshold.</td></tr>
          {% endif %}

          <tr><td style="padding:25px 26px 7px;border-top:1px solid #D9E0E7;"><h2 style="margin:0;font-size:19px;line-height:1.3;color:#14243A;">Watch Today</h2></td></tr>
          {% if briefing.watch_today %}
            {% for item in briefing.watch_today %}
            <tr><td style="padding:8px 26px 11px;font-size:13px;line-height:1.55;color:#33465A;">• {{ item.text }}</td></tr>
            {% endfor %}
          {% else %}
          <tr><td style="padding:9px 26px 20px;font-size:13px;line-height:1.55;color:#74808D;">No watch item was inferred; C9 does not invent future catalysts.</td></tr>
          {% endif %}

          <tr><td style="padding:25px 26px 9px;border-top:1px solid #D9E0E7;"><h2 style="margin:0;font-size:19px;line-height:1.3;color:#14243A;">Market Snapshot</h2></td></tr>
          {% if briefing.market_snapshot %}
            {% for group in briefing.market_snapshot %}
            <tr><td style="padding:8px 26px 11px;">
              <div style="font-size:10px;line-height:1.4;letter-spacing:1px;text-transform:uppercase;color:#74808D;font-weight:700;">{{ group.name }}</div>
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width:100%;border-collapse:collapse;">
                {% for item in group.items %}
                <tr>
                  <td style="padding:7px 0;border-bottom:1px solid #EDF0F3;font-size:13px;line-height:1.4;color:#33465A;">{{ item.name }}</td>
                  <td align="right" style="padding:7px 0;border-bottom:1px solid #EDF0F3;font-size:13px;line-height:1.4;color:{% if item.change_pct >= 0 %}#246B4A{% else %}#8A4A42{% endif %};font-weight:700;white-space:nowrap;">{{ '%+.2f'|format(item.change_pct) }}%</td>
                </tr>
                {% endfor %}
              </table>
            </td></tr>
            {% endfor %}
          {% else %}
          <tr><td style="padding:9px 26px 20px;font-size:13px;line-height:1.55;color:#74808D;">No completed market observation is available.</td></tr>
          {% endif %}

          <tr><td style="padding:24px 26px 28px;border-top:1px solid #D9E0E7;background:#F7F8FA;">
            <h2 style="margin:0 0 8px;font-size:15px;line-height:1.3;color:#14243A;">Sources &amp; Data Quality</h2>
            <div style="font-size:12px;line-height:1.65;color:#667482;">{{ briefing.data_quality.status }} · {{ briefing.data_quality.documents }} documents · {{ briefing.data_quality.events }} Events · {{ briefing.data_quality.markets }} market observations<br>{{ briefing.data_quality.sources_healthy }}/{{ briefing.data_quality.sources_total }} sources healthy · AI {{ briefing.data_quality.ai_status }} · Validated reaction coverage {% if briefing.data_quality.has_validated_market_reactions %}present{% else %}absent{% endif %}</div>
            <div style="margin-top:13px;font-size:10px;line-height:1.55;color:#87929E;">Evidence-linked intelligence, not investment advice. Market reactions are observational associations and do not establish causality.</div>
          </td></tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
