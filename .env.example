APP_ENV=development
DATA_MODE=demo
DATABASE_URL=sqlite:///work/radar.db
REPORT_OUTPUT_DIR=outputs/reports
BUSINESS_TIMEZONE=Asia/Shanghai
RADAR_VIEW_ID=global
LOOKBACK_HOURS=48

# AI is optional. A zero budget always disables pipeline calls.
AI_ENABLED=false
DAILY_LLM_BUDGET=0
AI_MAX_REQUESTS_PER_RUN=10
AI_MAX_INPUT_TOKENS_PER_RUN=
AI_MAX_OUTPUT_TOKENS_PER_RUN=
# Optional C9.1 Chinese-first bilingual presentation; remains off by default.
LOCALIZATION_ENABLED=false
LOCALIZATION_LOCALE=zh-CN
LOCALIZATION_MODEL=
LOCALIZATION_TIMEOUT_SECONDS=90
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-flash
LLM_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
LLM_TIMEOUT_SECONDS=30

# Cloud MVP scheduled runs use smtp. Keep credentials in GitHub Secrets, never here.
EMAIL_MODE=disabled
EMAIL_FROM=
EMAIL_TO=
AUDIENCE_ENABLED=false
MAX_ACTIVE_RECIPIENTS=20
OPERATOR_EMAIL=
AUDIENCE_ADMIN_TOKEN=
ADMIN_PORT=8765
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Required for compliant SEC Submissions collection in live mode.
SEC_CONTACT_EMAIL=
