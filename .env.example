APP_ENV=development
DATA_MODE=demo
DATABASE_URL=sqlite:///work/radar.db
REPORT_OUTPUT_DIR=outputs/reports
BUSINESS_TIMEZONE=Asia/Shanghai
LOOKBACK_HOURS=48

# AI is optional. A zero budget always disables pipeline calls.
AI_ENABLED=false
DAILY_LLM_BUDGET=0
AI_MAX_REQUESTS_PER_RUN=10
AI_MAX_INPUT_TOKENS_PER_RUN=
AI_MAX_OUTPUT_TOKENS_PER_RUN=
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-flash
LLM_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
LLM_TIMEOUT_SECONDS=30

# Cloud MVP scheduled runs use smtp. Keep credentials in GitHub Secrets, never here.
EMAIL_MODE=disabled
EMAIL_FROM=
EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Required only when SEC company filing collection is enabled in a later phase.
SEC_CONTACT_EMAIL=
