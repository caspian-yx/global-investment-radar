APP_ENV=development
DATA_MODE=demo
DATABASE_URL=sqlite:///work/radar.db
REPORT_OUTPUT_DIR=outputs/reports
BUSINESS_TIMEZONE=Asia/Shanghai
LOOKBACK_HOURS=48

# AI is optional. A zero budget always disables calls.
AI_ENABLED=false
DAILY_LLM_BUDGET=0
LLM_PROVIDER=disabled
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=

# Cloud MVP scheduled runs use smtp. Keep credentials in GitHub Secrets, never here.
EMAIL_MODE=disabled
EMAIL_FROM=
EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Required only when SEC company filing collection is enabled in a later phase.
SEC_CONTACT_EMAIL=
